# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Feature flags
# Set to true to enable Zitadel JWT authentication on protected endpoints
ZITADEL_ENABLED=false
# Set to true to enable Prometheus metrics, OpenTelemetry tracing, and Grafana
OBSERVABILITY=false

# Zitadel — base domain (no trailing slash), e.g. https://zitadel.example.com
# Required only when ZITADEL_ENABLED=true
ZITADEL_DOMAIN=https://zitadel.example.com

# Zitadel — host only (no scheme), used for HTTP_CLIENT_URL
ZITADEL_HOST=zitadel.example.com

# Zitadel project ID
PROJECT_ID=

# OAuth2 client (used by app-a and app-b)
CLIENT_ID=
APP_A_CLIENT_SECRET=
APP_B_CLIENT_SECRET=

# Service-to-service API client
API_CLIENT_ID=
API_CLIENT_SECRET=
