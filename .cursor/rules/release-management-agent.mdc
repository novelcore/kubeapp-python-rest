## Deployment Monitoring

### Health Checks
```bash
# Application health
check_health() {
  local ENV=$1
  local URL=$2
  
  echo "🔍 Checking $ENV environment health..."
  
  # Basic health check
  if curl -f "$URL/healthz" >/dev/null 2>&1; then
    echo "✅ $ENV: Health check passed"
  else
    echo "❌ $ENV: Health check failed"
    return 1
  fi
  
  # Check specific endpoints
  if curl -f "$URL/" >/dev/null 2>&1; then
    echo "✅ $ENV: Root endpoint accessible"
  else
    echo "❌ $ENV: Root endpoint failed"
    return 1
  fi
}

# Check all environments
check_health "Development" "https://dev-api.domain.com"
check_health "Staging" "https://staging-api.domain.com"
check_health "Production" "https://api.domain.com"
```

### Rollback Procedures
```bash
rollback_deployment() {
  local ENV=$1
  local PREVIOUS_VERSION=$2
  
  echo "🔄 Rolling back $ENV to version $PREVIOUS_VERSION..."
  
  # Using GitHub MCP to trigger rollback
  gh workflow run rollback.yml -f environment="$ENV" -f version="$PREVIOUS_VERSION"
  
  # Monitor rollback progress
  sleep 30
  check_health "$ENV" "https://${ENV}-api.domain.com"
}
```

