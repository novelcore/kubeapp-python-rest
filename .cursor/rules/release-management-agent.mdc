## Technical Implementation

### GitHub CLI Operations
```bash
# Create PR with specific template
create_feature_pr() {
  local BRANCH="$1"
  local DESCRIPTION="$2"
  
  gh pr create \
    --base dev \
    --head "$BRANCH" \
    --title "$(get_branch_type "$BRANCH"): $DESCRIPTION" \
    --body "$(generate_pr_body "$BRANCH" "$DESCRIPTION")"
}

# Add preview label
add_preview_label() {
  local PR_NUMBER="$1"
  gh pr edit "$PR_NUMBER" --add-label "preview"
}

# Monitor workflow
monitor_workflow() {
  local WORKFLOW="preview-request.yaml"
  gh run list --workflow="$WORKFLOW" --limit=1 --json databaseId --jq '.[0].databaseId'
}
```

### Deployment Monitoring
```bash
# Check deployment health
check_preview_health() {
  local PR_NUMBER="$1"
  local APP_NAME="$2"
  local DOMAIN="$3"
  
  local PREVIEW_URL="https://${PR_NUMBER}-${APP_NAME}.preview.${DOMAIN}"
  
  if curl -f -s "${PREVIEW_URL}/healthz" >/dev/null; then
    echo "✅ Preview deployment healthy"
    return 0
  else
    echo "❌ Preview deployment not responding"
    return 1
  fi
}

# Get ArgoCD status
get_argocd_status() {
  local APP_NAME="$1"
  local PR_NUMBER="$2"
  local DOMAIN="$3"
  
  echo "https://argocd.${DOMAIN}/applications/argocd/${APP_NAME}-preview-${PR_NUMBER}"
}
```

